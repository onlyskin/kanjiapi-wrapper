#!/bin/bash

# Fail loudly rather than leaving a stale or missing bundle behind, so that
# `yarn release` can't publish a broken build.
set -euo pipefail

ESBUILD=node_modules/.bin/esbuild
OUT_FILE=kanjiapi-wrapper.min.js

# es2017 leaves async/await untranspiled, matching the syntax level that the
# previous babel/browserify pipeline shipped.
$ESBUILD browser.js --bundle --minify --target=es2017 --outfile=$OUT_FILE
